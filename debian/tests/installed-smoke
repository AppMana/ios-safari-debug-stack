#!/bin/sh
set -eu

ios-safari-debug version
ios-safari-debug backend get >/dev/null
ios_webkit_debug_proxy --version
ios-safari-cdp-bridge --help >/dev/null
test -f /usr/share/ios-safari-debug-stack/web-inspector/Main.html
test -f /usr/lib/systemd/system/ios-safari-debug-wip.service
test -f /usr/lib/systemd/system/ios-safari-debug-cdp.service
test -f /usr/lib/systemd/system/ios-safari-debug-evaluate.service
test -f /usr/lib/systemd/system/ios-safari-debug-ui.service
test -f /usr/lib/systemd/system/usbmuxd.service.d/10-ios-safari-preserve-pairing.conf
test -f /usr/lib/systemd/system/usbmuxd.service.d/20-ios-safari-no-start-limit.conf
test -f /usr/lib/systemd/network/05-ios-safari-ignore-ipheth.network
test ! -e /usr/lib/modprobe.d/ios-safari-debug-stack.conf
test -f /usr/lib/udev/rules.d/38-ios-safari-usb-stability.rules
